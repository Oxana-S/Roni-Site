# Магазин: снаружи открываются только checkout.php, notify.php, return.php, status.php, download.php.
# config.php (ключ myPOS) и lib.php — закрыты. На nginx этот файл не действует — тогда они просто выполняются
# как PHP и ничего не показывают. Заказы лежат в .data/ в .php-файлах с exit в начале — тоже ничего не покажут.
<FilesMatch "^(config|config\.sample|lib)\.php$">
  <IfModule mod_authz_core.c>
    Require all denied
  </IfModule>
  <IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
  </IfModule>
</FilesMatch>
